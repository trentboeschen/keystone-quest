<?php
// Keystone Quest settings.
// Copy this file to config.php and edit the copy. config.php is ignored by git,
// so your password never ends up in the repository.
// Change this before uploading. Anyone with this password can create, edit and delete adventures.
// Leave it empty ('') to switch editing off completely.
const EDIT_PASSWORD = 'change-me';

// How many earlier versions of each adventure to keep in adventures/_backups/
const BACKUPS_PER_ADVENTURE = 20;

// Show typing speed (words per minute) to players: true or false.
// Speed is always recorded in each player's data either way; this only hides it
// on the play screen, endings, adventure cards and player panel.
const SHOW_TYPING_SPEED = true;
